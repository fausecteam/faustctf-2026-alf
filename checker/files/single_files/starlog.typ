#set page(numbering: "1 / 1")
#set heading(numbering: "01.")
#let title = "$title"
#let author = "$author"

#align(center)[
  #set text(size: 26pt, weight: "bold")
  #title
  #v(6pt)
  #set text(size: 12pt, style: "italic", weight: "regular")
  Stellar Navigation Log — Navigator of record: #author
]

#line(length: 100%, stroke: 0.6pt)
#v(0.8cm)

= Departure Vector
#text("$chap1")

= Course Corrections
#text("$chap2")

= Arrival Beacon
#text("$chap3")
